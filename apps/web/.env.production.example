# Variables d'environnement de PRODUCTION (à définir dans Vercel › Settings › Environment
# Variables, pour les environnements Production et Preview). NE PAS committer de valeurs réelles.
# Voir docs/architecture/15-deploiement.md pour la procédure complète.

# Connexion applicative : rôle RESTREINT `consulpro_app`, soumis à la RLS (jamais le propriétaire).
# Utiliser l'URL POOLÉE de l'hébergeur (serverless) : Neon « -pooler », Supabase port 6543 (pgBouncer).
DATABASE_URL="postgresql://consulpro_app:MOT_DE_PASSE@HOTE-POOLER:5432/consulpro?sslmode=require"

# URL publique de l'application (liens des e-mails et contrôle d'origine des requêtes API).
# DOIT correspondre au domaine servi par Vercel, en https.
APP_URL="https://app.exemple.com"

# Secret des sessions : 32 caractères minimum, ALÉATOIRE et secret. Générer avec :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="a-remplacer-par-un-secret-aleatoire-de-32-caracteres-min"

# Environnement de déploiement : production (interdit les moteurs de démonstration).
APP_ENV="production"

# SMTP — OPTIONNEL. Sans ces variables : aucun e-mail n'est envoyé et l'inscription donne un
# accès immédiat (pas de vérification par e-mail). Les définir (toutes) active la vérification
# par e-mail à l'inscription + la réinitialisation de mot de passe. Tout ou rien.
# SMTP_HOST="smtp.exemple.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey-ou-utilisateur"
# SMTP_PASSWORD="secret-smtp"
# MAIL_FROM="ConsulPro <no-reply@app.exemple.com>"

# Fuseau horaire par défaut (IANA) ; chaque utilisateur peut choisir le sien.
APP_TIME_ZONE="Africa/Abidjan"

# NE PAS définir CONSULPRO_DEMO_ENGINES en production : les moteurs de démonstration y sont refusés
# (apps/web/src/server/env.ts arrête le serveur si APP_ENV=production et CONSULPRO_DEMO_ENGINES=true).

# --- Migrations et chargement des référentiels (hors runtime Vercel) ---
# Exécutées localement ou en CI avec le rôle PROPRIÉTAIRE et l'URL DIRECTE (non poolée).
# Ne PAS définir cette variable dans Vercel (l'app ne doit jamais utiliser le propriétaire).
#   DATABASE_ADMIN_URL="postgresql://consulpro:MOT_DE_PASSE_PROPRIO@HOTE-DIRECT:5432/consulpro?sslmode=require"
