# Copier en .env.local pour le développement (valeurs de docker/compose.dev.yml).

# Rôle applicatif restreint, soumis à la RLS (jamais le rôle propriétaire).
DATABASE_URL="postgresql://consulpro_app:consulpro_app@localhost:5434/consulpro"

# URL publique de l'application (liens des e-mails, contrôle d'origine).
APP_URL="http://localhost:3000"

# Secret des sessions : 32 caractères minimum. Générer par exemple avec :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres-min"

# E-mails : Mailpit en développement (interface http://localhost:8025).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="ConsulPro <no-reply@consulpro.local>"

# Fuseau horaire par défaut (IANA) ; chaque utilisateur peut choisir le sien.
APP_TIME_ZONE="Africa/Abidjan"

# Environnement : development | test | staging | production (défaut : production si
# NODE_ENV=production, sinon development).
# APP_ENV="development"

# Moteurs de démonstration, SANS valeur technique : développement et test uniquement
# (refusés quand l'environnement est « production »).
CONSULPRO_DEMO_ENGINES="true"
