{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "lint": {
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["generate", "^generate"],
      "cache": false
    },
    "build": {
      "dependsOn": ["generate", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["generate", "^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
