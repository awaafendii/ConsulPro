      },
      "expected": {
        "resultStatus": "OK_WITH_WARNINGS",
        "outputs": {
          "deltaSum": { "value": -0.002, "tolerance": 1e-9 },
          "computedEndElevation": { "value": 99.998, "tolerance": 1e-9 },
          "knownEndElevation": { "value": 100, "tolerance": 1e-9 },
          "closure": { "value": -0.002, "tolerance": 1e-9 },
          "stationCount": { "value": 3, "tolerance": 0 },
          "correctionPerStation": { "value": 0.0006666666666666666, "tolerance": 1e-9 },
          "compensatedEndElevation": { "value": 100, "tolerance": 1e-9 }
        },
        "checks": [{ "rule": "topo.leveling.closure", "status": "PASS" }],
        "hypotheses": ["DEFAULT.endElevation", "TOPO.ANGLE_CONVENTION"]
      }
    },
