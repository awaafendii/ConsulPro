          { "back": { "value": 1.5, "unit": "m" }, "fore": { "value": 1.2, "unit": "m" } },
          { "back": { "value": 1.0, "unit": "m" }, "fore": { "value": 1.1, "unit": "m" } },
          { "back": { "value": 1.3, "unit": "m" }, "fore": { "value": 1.502, "unit": "m" } }
